# --- Django ------------------------------------------------------------------

# Geheimer Schlüssel, pro Umgebung ein eigener langer Zufallswert
SECRET_KEY=<langer-zufälliger-wert>
# True nur für die Entwicklung
DEBUG=False
# Kommagetrennt, ohne Leerzeichen (für das Handy im WLAN die LAN-IP ergänzen)
ALLOWED_HOSTS=localhost,127.0.0.1


# --- E-Mail (SMTP) -----------------------------------------------------------

# Zum Testen ohne Mailserver aktivieren (Mails erscheinen im Log des Workers)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=<smtp.example.com>
EMAIL_PORT=587
# Genau eines auf True: Port 587 -> TLS, Port 465 -> SSL
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<smtp-benutzer>
EMAIL_HOST_PASSWORD=<smtp-passwort>
# Ohne Angabe wird EMAIL_HOST_USER verwendet
DEFAULT_FROM_EMAIL=<absender@example.com>


# --- Redis -------------------------------------------------------------------

# Servicename aus der docker-compose.yml, nicht ändern
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<redis-passwort>


# --- Datenbank (PostgreSQL) ----------------------------------------------------

DB_NAME=<datenbankname>
DB_USER=<datenbankbenutzer>
DB_PASSWORD=<datenbank-passwort>
# Servicename aus der docker-compose.yml, nicht ändern
DB_HOST=db
DB_PORT=5432


# --- Admin-Benutzer (wird beim Start angelegt) ---------------------------------

DJANGO_SUPERUSER_EMAIL=<admin@example.com>
DJANGO_SUPERUSER_USERNAME=<admin>
DJANGO_SUPERUSER_PASSWORD=<starkes-passwort>


# --- Docker Compose --------------------------------------------------------------

# NUR LOKAL aktivieren (Entwicklungsmodus: Code-Änderungen ohne Neubau).
# Auf dem Server auskommentiert lassen, dann läuft nur die docker-compose.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
